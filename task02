#include <stdio.h>
#include<ctype.h>

void displayWelcomeMessage();
void showProductMenu();
double getProductPrice(int choice);
double calculateItemPrice(double price, int quantity);
double calculateDiscount(double subtotal);
double calculateFinalBill(double subtotal, double discount);
void displayReceipt(int q1, int q2, int q3, int q4, int q5, double t1, double t2, double t3, double t4, double t5, double sub, double disc, double finalBill);
int askToContinue();

int main() {
    
    int choice = 0, quantity = 0;
    int shopping = 1;
    
    
      int qty1 = 0, qty2 = 0, qty3 = 0, qty4 = 0, qty5 = 0;

    double total1 = 0.0, total2 = 0.0, total3 = 0.0, total4 = 0.0, total5 = 0.0;
    
    double subtotal = 0.0, discount = 0.0, finalBill = 0.0;

    displayWelcomeMessage();

    while (shopping == 1) {
        showProductMenu();
        
        printf("Enter product number (1-5): ");
        scanf("%d", &choice);

        if (choice < 1 || choice > 5) {
            printf("Invalid selection! Please try again.\n");
            continue;
        }

        printf("Enter quantity: ");
        scanf("%d", &quantity);

        if (quantity <= 0) {
            printf("Quantity must be greater than 0.\n");
            continue;
        }


        double unitPrice = getProductPrice(choice);
    
        double totalItemPrice = calculateItemPrice(unitPrice, quantity);

         
        if (choice == 1) {
            qty1 = qty1 + quantity;            
            total1 = total1 + totalItemPrice;  
        } 
        else if (choice == 2) {
            qty2 = qty2 + quantity;
            total2 = total2 + totalItemPrice;
        } 
        else if (choice == 3) {
            qty3 = qty3 + quantity;
            total3 = total3 + totalItemPrice;
        } 
        else if (choice == 4) {
            qty4 = qty4 + quantity;
            total4 = total4 + totalItemPrice;
        } 
        else if (choice == 5) {
            qty5 = qty5 + quantity;
            total5 = total5 + totalItemPrice;
        }

        printf("Item added to cart successfully!\n");

        shopping = askToContinue();
    }

    
    subtotal = total1 + total2 + total3 + total4 + total5;
    
    discount = calculateDiscount(subtotal);
    finalBill = calculateFinalBill(subtotal, discount);

    
    displayReceipt(qty1, qty2, qty3, qty4, qty5, total1, total2, total3, total4, total5, subtotal, discount, finalBill);

    return 0;
}



void displayWelcomeMessage() {
    
    printf(" welcome to the shop\n");
    
}

void showProductMenu() {
    printf("\n Available Products Menu");
    printf("1. Laptop Bag              - Rs. 1500.00\n");
    printf("2. Wireless Mouse          - Rs.  800.00\n");
    printf("3. Mechanical Keyboard     - Rs. 3500.00\n");
    printf("4. USB-C Hub               - Rs. 1200.00\n");
    printf("5. LED Desk Lamp           - Rs. 1800.00\\n");
}

double getProductPrice(int choice) {
    if (choice == 1) return 1500.00;
    if (choice == 2) return 800.00;
    if (choice == 3) return 3500.00;
    if (choice == 4) return 1200.00;
    if (choice == 5) return 1800.00;
    return 0.00;
}


double calculateItemPrice(double price, int quantity) {
    double result = price * quantity; 
    return result; 
}

double calculateDiscount(double subtotal) {
    if (subtotal >= 2000.0) {
        return subtotal * 0.10;
    }
    return 0.0;
}

double calculateFinalBill(double subtotal, double discount) {
    return subtotal - discount;
}

void displayReceipt(int q1, int q2, int q3, int q4, int q5, double t1, double t2, double t3, double t4, double t5, double sub, double disc, double finalBill) {

    printf("final receipt\n");
    
    printf("Item Name   Qty   Price      Total\n");
    
    
    if (q1 > 0) printf("Laptop Bag              %d Rs.1500.00 Rs.%.2f\n", q1, t1);
    if (q2 > 0) printf("Wireless Mouse          %d Rs.800.00  Rs.%.2f\n", q2, t2);
    if (q3 > 0) printf("Mechanical Keyboard     %d Rs.3500.00 Rs.%.2f\n", q3, t3);
    if (q4 > 0) printf("USB-C Hub               %d Rs.1200.00 Rs.%.2f\n", q4, t4);
    if (q5 > 0) printf("LED Desk Lamp           %d Rs.1800.00 Rs.%.2f\n", q5, t5);
    

    printf("Subtotal:                     Rs.%.2f\n", sub);
    printf("Discount Applied:             Rs.%.2f\n", disc);
    
    printf("Grand Total:                  Rs.%.2f\n", finalBill);

    printf("Thank you for shopping with us\n");

}

int askToContinue() {
    char ch;
    printf("\nDo you want to add another item? (Y/N): ");
    scanf(" %c", &ch);
    ch = toupper(ch);
    if (ch == 'Y') {
        return 1;
    }
    return 0;
}
